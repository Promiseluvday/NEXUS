# Copy this file to ".env.local" and fill in the values.
# ".env.local" is ignored by Git. Never commit real keys.
#
# For your PC: run "npm run db:status" and copy API_URL and ANON_KEY.
# The local values are the standard Supabase demo values, the same on every
# install. A real server has its own, which stay out of Git.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-here

# Usernames sign in as "<username>@<this domain>" behind the scenes (D-206).
# Must match the operator setting auth.username_email_domain.
VITE_USERNAME_EMAIL_DOMAIN=users.nexus.local
